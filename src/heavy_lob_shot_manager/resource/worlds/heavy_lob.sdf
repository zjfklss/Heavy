<?xml version="1.0" ?>
<!-- 本队 Jazzy + Gazebo Harmonic 8 吊射可视化。不编 ITL Fortress 仿真栈。 -->
<sdf version="1.8">
  <world name="heavy_lob">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.18 0.22 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>8 0 12 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.15 0.18 0.22</background_color>
        <camera_pose>10 -12 7 0 0.45 1.25</camera_pose>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
      </plugin>
    </gui>

    <!-- RM 场地底板：原点在场角，车在 (3, 1.5)，基地在 (23.125, 1.510) -->
    <model name="field">
      <static>true</static>
      <pose>14 7.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>28 15 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>28 15 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.22 0.18 1</ambient>
            <diffuse>0.25 0.32 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 先验基地点可视化 -->
    <model name="base_target">
      <static>true</static>
      <pose>23.125 1.510 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.84</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
        <visual name="light">
          <pose>0 0 0.84 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.18</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.0 0.9 0.2 1</ambient>
            <diffuse>0.1 1.0 0.2 1</diffuse>
            <emissive>0.0 0.6 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="heavy_hero">
      <pose>3 1.5 0.15 0 0 0</pose>
      <self_collide>false</self_collide>
      <link name="base_link">
        <inertial>
          <mass>40</mass>
          <inertia>
            <ixx>1.2</ixx>
            <iyy>1.4</iyy>
            <izz>1.5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="chassis">
          <geometry>
            <box>
              <size>0.70 0.55 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 0.55 1</ambient>
            <diffuse>0.15 0.40 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="chassis">
          <geometry>
            <box>
              <size>0.70 0.55 0.30</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="yaw_link">
        <pose>0 0 0.20 0 0 0</pose>
        <inertial>
          <mass>4</mass>
          <inertia>
            <ixx>0.05</ixx>
            <iyy>0.05</iyy>
            <izz>0.04</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="yaw">
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.25 0.25 0.30 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="pitch_link">
        <pose>0.05 0 0.25 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.02</ixx>
            <iyy>0.08</iyy>
            <izz>0.08</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="barrel">
          <pose>0.28 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.55</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.35 0.05 1</ambient>
            <diffuse>0.95 0.45 0.08 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="world_fixed" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>
      <joint name="yaw_joint" type="revolute">
        <parent>base_link</parent>
        <child>yaw_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-3.14</lower>
            <upper>3.14</upper>
          </limit>
          <dynamics>
            <damping>1.0</damping>
          </dynamics>
        </axis>
      </joint>
      <joint name="pitch_joint" type="revolute">
        <parent>yaw_link</parent>
        <child>pitch_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1.60</lower>
            <upper>0.20</upper>
          </limit>
          <dynamics>
            <damping>1.0</damping>
          </dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>yaw_joint</joint_name>
        <topic>yaw_cmd</topic>
        <p_gain>40</p_gain>
        <i_gain>0.2</i_gain>
        <d_gain>4</d_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>pitch_joint</joint_name>
        <topic>pitch_cmd</topic>
        <p_gain>40</p_gain>
        <i_gain>0.2</i_gain>
        <d_gain>4</d_gain>
      </plugin>
    </model>
  </world>
</sdf>
