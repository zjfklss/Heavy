# 抄自 ITL Real/src/bringup/rviz/nav.rviz，话题改成本队 /lob_shot/*，并加上 STL 栅格地图。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Update Interval: 0
      Frame Timeout: 15
      Frames:
        All Enabled: true

    - Class: rviz_default_plugins/Marker
      Name: FieldMesh
      Enabled: true
      Value: true
      Topic:
        Value: /lob_shot/field_mesh
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/PointCloud2
      Name: PriorMap
      Enabled: true
      Value: true
      Topic:
        Value: /prior_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 1
      Style: Points
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Alpha: 0.45
      Decay Time: 0
      Use Fixed Frame: true

    - Class: rviz_default_plugins/PointCloud2
      Name: RegisteredScan
      Enabled: true
      Value: true
      Topic:
        Value: /registered_scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true

    - Class: rviz_default_plugins/PointCloud2
      Name: RelocSeeded
      Enabled: true
      Value: true
      Topic:
        Value: /reloc/scan_seeded
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Alpha: 0.7
      Decay Time: 0
      Use Fixed Frame: true

    - Class: rviz_default_plugins/PointCloud2
      Name: RelocAligned
      Enabled: true
      Value: true
      Topic:
        Value: /reloc/aligned
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 80; 255; 80
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true

    - Class: rviz_default_plugins/Marker
      Name: Trajectory
      Enabled: true
      Value: true
      Topic:
        Value: /lob_shot/trajectory
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/MarkerArray
      Name: LobShotViz
      Enabled: true
      Value: true
      Topic:
        Value: /lob_shot/visualization
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 14.5
        Y: 8.0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.20
      Target Frame: <Fixed Frame>
      Value: Orbit
      Yaw: 0.6
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1200
  X: 100
  Y: 100
